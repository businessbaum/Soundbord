<?xml version="1.0" encoding="utf-8"?>
<!--
  Eine einzelne Soundbord.exe, die auch ohne installierte .NET-Runtime läuft.
  Aufruf:  dotnet publish src\Soundbord -p:PublishProfile=win-x64

  Gemessen auf Windows 11 / .NET 9:
    EXE 160 MB · WorkingSet 144 MB · Private Bytes 116 MB
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\dist\win-x64</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Bewusst AUS: die Komprimierung halbiert zwar die Dateigröße, entpackt aber
         beim Start alles in den Arbeitsspeicher und kostet gemessene 85 MB RAM
         (228 statt 144 MB). Für eine App, die dauerhaft im Hintergrund läuft,
         ist das der schlechtere Tausch. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Kostet 34 MB Dateigröße, kauft dafür spürbar schnelleren Kaltstart.
         Auf den Speicherbedarf hat es keinen messbaren Einfluss. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Kein Trimming: NAudio und System.Text.Json arbeiten hier über Reflexion. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
