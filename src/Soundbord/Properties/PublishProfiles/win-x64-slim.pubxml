<?xml version="1.0" encoding="utf-8"?>
<!--
  Schlanke Variante: setzt die installierte .NET 9 Desktop Runtime voraus.
  Aufruf:  dotnet publish src\Soundbord -p:PublishProfile=win-x64-slim

  Gemessen auf Windows 11 / .NET 9:
    EXE 10,5 MB · WorkingSet 135 MB · Private Bytes 116 MB

  Für den Eigengebrauch die bessere Wahl – gleicher Speicherbedarf, aber ein
  Fünfzehntel der Dateigröße. Zum Weitergeben an Dritte lieber win-x64 nehmen.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\dist\win-x64-slim</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
